rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Restaurant POS collections - accessible for point-of-sale terminals, counter billing, and authenticated staff
    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /menu_items/{itemId} {
      allow read, write: if true;
    }

    match /kots/{kotId} {
      allow read, write: if true;
    }

    match /kot_items/{itemId} {
      allow read, write: if true;
    }

    match /bills/{billId} {
      allow read, write: if true;
    }

    match /billing_drafts/{draftId} {
      allow read, write: if true;
    }

    match /bill_items/{itemId} {
      allow read, write: if true;
    }

    match /business_days/{dayId} {
      allow read, write: if true;
    }

    match /bill_counters/{counterId} {
      allow read, write: if true;
    }

    match /inventory_items/{itemId} {
      allow read, write: if true;
    }

    match /inventory_movements/{movementId} {
      allow read, write: if true;
    }

    match /purchases/{purchaseId} {
      allow read, write: if true;
    }

    match /purchase_items/{itemId} {
      allow read, write: if true;
    }

    match /stock_adjustments/{adjId} {
      allow read, write: if true;
    }

    match /wastage/{wastageId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }
    
    match /roles/{roleId} {
      allow read, write: if true;
    }

    match /permissions/{permissionId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /user_activity_logs/{logId} {
      allow read, write: if true;
    }

    match /print_logs/{logId} {
      allow read, create, update, delete: if true;
    }

    match /print_queue/{jobId} {
      allow read, write: if true;
    }

    match /sync_metadata/{metaId} {
      allow read, write: if true;
    }

    match /daily_backups/{backupId} {
      allow read, write: if true;
    }

    // Automatic Daily Sales Backup records (PDF & Excel metadata and cloud storage paths)
    match /daily_sales_backups/{backupDateId} {
      allow read: if true;
      allow create, update: if request.resource.data.businessDate is string
        && request.resource.data.pdfFileName is string
        && request.resource.data.excelFileName is string;
      allow delete: if isAuthenticated();
    }

    // Security Audit Logs (immutable append-only audit trail for logins, failed PINs, lockouts, and downloads)
    match /security_audit_logs/{logId} {
      allow read: if true;
      allow create: if request.resource.data.eventType is string
        && request.resource.data.timestamp is number;
      allow update, delete: if false;
    }

    // Login Rate Limits & Account Lockout state
    match /login_rate_limits/{usernameId} {
      allow read, write: if true;
    }

    match /test/{testId} {
      allow read, write: if true;
    }
  }
}

